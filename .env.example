# Local database and private managed-image storage. Both remain gitignored.
BEAUTIO_DB_PATH=.local/beautio-validation.sqlite
BEAUTIO_IMAGE_STORAGE_ROOT=.local/managed-images

# Set MCP upload root to an absolute, controlled directory before starting either stdio MCP.
BEAUTIO_MCP_UPLOAD_ROOT=

# Production stdio MCP is a thin HTTPS client. The token file must be an
# absolute, current-user-owned, non-symlink regular file with mode 0600.
BEAUTIO_REMOTE_ORIGIN=https://beautio.example.com
BEAUTIO_ACTION_TOKEN_FILE=

# Use two different long random values. Never commit their real values.
BEAUTIO_ACTION_BEARER_TOKEN=
BEAUTIO_ADMIN_BEARER_TOKEN=

# Comma-separated trusted Action file hosts. Entries are exact except that the
# explicit oaiusercontent.com root also accepts its dot-boundary subdomains.
BEAUTIO_ACTION_FILE_HOST_ALLOWLIST=

# Optional production same-origin hosting. WEB_ROOT must be an absolute built-web
# directory; PUBLIC_ORIGIN must be the exact external HTTPS origin with no path.
BEAUTIO_WEB_ROOT=
BEAUTIO_PUBLIC_ORIGIN=

# Optional read-only remote MCP. The endpoint does not exist unless explicitly
# enabled. Access policy is the only place that stores the real email; never
# commit any production value below. TEAM_DOMAIN is an exact
# https://<team>.cloudflareaccess.com origin.
BEAUTIO_REMOTE_MCP_ENABLED=false
BEAUTIO_REMOTE_MCP_HOST=mcp.beautio.example.com
BEAUTIO_ACCESS_TEAM_DOMAIN=https://team.cloudflareaccess.com
BEAUTIO_ACCESS_AUDIENCE=

# Keep loopback outside containers. A private Docker network may set 0.0.0.0 so
# a sibling proxy can connect without publishing this port on the host.
BEAUTIO_API_HOST=127.0.0.1
BEAUTIO_API_PORT=8787
# Local Vite development only; production static files use BEAUTIO_WEB_ROOT.
BEAUTIO_WEB_PORT=4173
