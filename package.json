{
  "name": "beautio",
  "version": "0.0.0",
  "private": true,
  "description": "Inventory-first personal beauty management core and adapters.",
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "check": "pnpm typecheck && pnpm test",
    "dev": "node scripts/dev.ts",
    "import:local": "node scripts/import-local-data.ts",
    "test": "node --test apps/*/test/*.test.ts packages/*/test/*.test.ts services/*/test/*.test.ts",
    "typecheck": "tsc --project tsconfig.scripts.json --noEmit && pnpm --recursive --if-present run typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "7.0.2"
  }
}
